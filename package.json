{
  "name": "jokenpo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Jokenpô online em tempo real, com Preact e Firebase Realtime Database.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/murillo-ferrari/jokenpo.git"
  },
  "scripts": {
    "dev": "vite",
    "dev:emulators": "firebase emulators:start --only auth,database --project demo-jokenpo",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:emulator": "firebase emulators:exec --only auth,database --project demo-jokenpo \"vitest run --config vitest.emulator.config.ts\""
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "firebase": "^13.2.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^26.6.6",
    "firebase-tools": "^15.35.0",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
