# Copie para .env.local (que não vai para o git).
#
# Opção 1, desenvolvimento sem credenciais: use os emuladores locais.
# Rode `npm run dev:emulators` em um terminal e `npm run dev` em outro.
VITE_USE_EMULATORS=true

# Opção 2, apontar para o projeto real do Firebase:
# defina VITE_USE_EMULATORS=false e preencha os valores abaixo
# (Console do Firebase > Configurações do projeto > Seus apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
